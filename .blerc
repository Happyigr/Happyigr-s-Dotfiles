bleopt highlight_syntax=
bleopt highlight_filename=
bleopt highlight_variable=

ble-bind -m auto_complete -f C-l auto_complete/insert

ble-face -s syntax_error fg=#f38ba8  # Red background, Crust foreground for better contrast
ble-face -s argument_error  fg=#f38ba8 # Red background, Crust foreground for better contrast
ble-face -s auto_complete fg=#9399b2,italic  # Overlay2
